    "zustand": "latest"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^25.9.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
