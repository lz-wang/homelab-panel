                        }
                    }
                ],
                "responses": {}
            }
        },
        "/logout": {
            "post": {
                "security": [
                    {
                        "ApiTokenAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "user"
                ],
                "summary": "Logout",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
