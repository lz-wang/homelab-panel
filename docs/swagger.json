    "definitions": {
        "apiReturn.Response": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "data": {},
                "msg": {
                    "type": "string"
                }
            }
        },
        "system.AboutData": {
            "type": "object",
            "properties": {
                "version": {
                    "type": "string"
                }
            }
        },
        "system.AboutResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "data": {
                    "$ref": "#/definitions/system.AboutData"
                },
                "msg": {
                    "type": "string"
                }
            }
        },
